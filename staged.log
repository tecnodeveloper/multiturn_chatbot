+INSERT INTO messages (message_id, chat_id, domain_id, sender, response, response_time, session_phase) VALUES
+('f0000000-0000-0000-0000-000000000001', 'd0000000-0000-0000-0000-000000000001', 'c0000000-0000-0000-0000-000000000001', 'user', 'What is the main difference between RF and XGBoost?', 0.5, 'start'),
+('f0000000-0000-0000-0000-000000000002', 'd0000000-0000-0000-0000-000000000002', 'c0000000-0000-0000-0000-000000000002', 'bot', 'PyTorch uses dynamic computational graphs, meaning gradients are calculated on the fly.', 1.2, 'middle'),
+('f0000000-0000-0000-0000-000000000003', 'd0000000-0000-0000-0000-000000000003', 'c0000000-0000-0000-0000-000000000003', 'user', 'Please check these patient logs for irregularities.', 0.3, 'start'),
+('f0000000-0000-0000-0000-000000000004', 'd0000000-0000-0000-0000-000000000004', 'c0000000-0000-0000-0000-000000000004', 'bot', 'Based on your data, cart abandonment peaks at the shipping cost stage.', 1.8, 'end'),
+('f0000000-0000-0000-0000-000000000005', 'd0000000-0000-0000-0000-000000000005', 'c0000000-0000-0000-0000-000000000005', 'user', 'How do we calculate load balancing across a 3-phase system?', 0.7, 'middle'),
+('f0000000-0000-0000-0000-000000000006', 'd0000000-0000-0000-0000-000000000006', 'c0000000-0000-0000-0000-000000000006', 'bot', 'Linear regression attempts to model the relationship between two variables by fitting a linear equation to observed data.', 2.1, 'start'),
+('f0000000-0000-0000-0000-000000000007', 'd0000000-0000-0000-0000-000000000007', 'c0000000-0000-0000-0000-000000000007', 'user', 'Does pooling reduce spatial dimensions in CNNs?', 0.4, 'end'),
+('f0000000-0000-0000-0000-000000000008', 'd0000000-0000-0000-0000-000000000008', 'c0000000-0000-0000-0000-000000000008', 'bot', 'Yes, transformers heavily rely on self-attention mechanisms to weigh the significance of different words.', 1.5, 'middle'),
+('f0000000-0000-0000-0000-000000000009', 'd0000000-0000-0000-0000-000000000009', 'c0000000-0000-0000-0000-000000000009', 'user', 'What are HIPAA constraints for cloud EHR storage?', 0.6, 'start'),
+('f0000000-0000-0000-0000-000000000010', 'd0000000-0000-0000-0000-000000000010', 'c0000000-0000-0000-0000-000000000010', 'bot', 'Dynamic pricing can increase revenue by 10-15% according to the competitor data you uploaded.', 2.4, 'end'),
+('f0000000-0000-0000-0000-000000000011', 'd0000000-0000-0000-0000-000000000011', 'c0000000-0000-0000-0000-000000000011', 'user', 'Show me the solar integration impact on the main grid.', 0.8, 'middle'),
+('f0000000-0000-0000-0000-000000000012', 'd0000000-0000-0000-0000-000000000012', 'c0000000-0000-0000-0000-000000000012', 'bot', 'K-Means requires you to define K beforehand, which is a major limitation.', 1.1, 'start'),
+('f0000000-0000-0000-0000-000000000013', 'd0000000-0000-0000-0000-000000000013', 'c0000000-0000-0000-0000-000000000013', 'user', 'How many epochs should I use for fine-tuning BERT?', 0.3, 'end'),
+('f0000000-0000-0000-0000-000000000014', 'd0000000-0000-0000-0000-000000000014', 'c0000000-0000-0000-0000-000000000014', 'bot', 'The AI detected a potential anomaly in the lower left quadrant of the X-ray sample.', 2.9, 'middle'),
+('f0000000-0000-0000-0000-000000000015', 'd0000000-0000-0000-0000-000000000015', 'c0000000-0000-0000-0000-000000000015', 'user', 'Which features correlate most with churn?', 0.5, 'start'),
+('f0000000-0000-0000-0000-000000000016', 'd0000000-0000-0000-0000-000000000016', 'c0000000-0000-0000-0000-000000000016', 'bot', 'Smart grid sensors use IoT protocols like MQTT to send high-frequency telemetry data.', 1.7, 'end'),
+('f0000000-0000-0000-0000-000000000017', 'd0000000-0000-0000-0000-000000000017', 'c0000000-0000-0000-0000-000000000017', 'user', 'Can we use SMOTE on this fraud dataset?', 0.6, 'middle'),
+('f0000000-0000-0000-0000-000000000018', 'd0000000-0000-0000-0000-000000000018', 'c0000000-0000-0000-0000-000000000018', 'bot', 'LSTMs handle the vanishing gradient problem better than standard RNNs, making them suited for long sequences.', 1.4, 'start'),
+('f0000000-0000-0000-0000-000000000019', 'd0000000-0000-0000-0000-000000000019', 'c0000000-0000-0000-0000-000000000019', 'user', 'Summarize the telemedicine survey results.', 0.9, 'end'),
+('f0000000-0000-0000-0000-000000000020', 'd0000000-0000-0000-0000-000000000020', 'c0000000-0000-0000-0000-000000000020', 'bot', 'Variant B achieved a 4.2% higher click-through rate, making it statistically significant.', 1.3, 'middle'),
+('f0000000-0000-0000-0000-000000000021', 'd0000000-0000-0000-0000-000000000021', 'c0000000-0000-0000-0000-000000000021', 'user', 'What is the degradation rate of these battery specs over 5 years?', 0.4, 'start'),
+('f0000000-0000-0000-0000-000000000022', 'd0000000-0000-0000-0000-000000000022', 'c0000000-0000-0000-0000-000000000022', 'bot', 'PCA helps by projecting high-dimensional data into a lower-dimensional space while preserving variance.', 1.6, 'end'),
+('f0000000-0000-0000-0000-000000000023', 'd0000000-0000-0000-0000-000000000023', 'c0000000-0000-0000-0000-000000000023', 'user', 'Why is mode collapse happening in my GAN?', 0.5, 'middle'),
+('f0000000-0000-0000-0000-000000000024', 'd0000000-0000-0000-0000-000000000024', 'c0000000-0000-0000-0000-000000000024', 'bot', 'The API rate limit for the health monitor endpoints is 100 requests per minute.', 0.9, 'start'),
+('f0000000-0000-0000-0000-000000000025', 'd0000000-0000-0000-0000-000000000025', 'c0000000-0000-0000-0000-000000000025', 'user', 'Identify overstocked items in the warehouse CSV.', 1.0, 'end'),
+('f0000000-0000-0000-0000-000000000026', 'd0000000-0000-0000-0000-000000000026', 'c0000000-0000-0000-0000-000000000026', 'bot', 'Microgrids can operate independently in island mode during a blackout.', 1.5, 'middle'),
+('f0000000-0000-0000-0000-000000000027', 'd0000000-0000-0000-0000-000000000027', 'c0000000-0000-0000-0000-000000000027', 'user', 'What does k-fold cross validation mean?', 0.3, 'start'),
+('f0000000-0000-0000-0000-000000000028', 'd0000000-0000-0000-0000-000000000028', 'c0000000-0000-0000-0000-000000000028', 'bot', 'Autoencoders detect anomalies by reconstructing inputs; high error signifies an anomaly.', 2.0, 'end'),
+('f0000000-0000-0000-0000-000000000029', 'd0000000-0000-0000-0000-000000000029', 'c0000000-0000-0000-0000-000000000029', 'user', 'Can AI predict binding affinities for these structures?', 0.7, 'middle'),
+('f0000000-0000-0000-0000-000000000030', 'd0000000-0000-0000-0000-000000000030', 'c0000000-0000-0000-0000-000000000030', 'bot', 'By using collaborative filtering, the system maps out user-item embeddings to recommend new products.', 1.8, 'start');
